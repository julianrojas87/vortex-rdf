{
    "name": "@vortex-rdf/vortex-rdf-store",
    "version": "0.5.0",
    "description": "High-performance, zero-copy columnar RDF serialization format",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vortex-rdf/vortex-rdf.git",
        "directory": "js"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "./entry/browser.js",
    "types": "./pkg/web/vortex_rdf.d.ts",
    "exports": {
        ".": {
            "types": "./pkg/web/vortex_rdf.d.ts",
            "node": "./entry/node.js",
            "browser": "./entry/browser.js",
            "default": "./entry/browser.js"
        }
    },
    "files": [
        "entry/node.js",
        "entry/node.d.ts",
        "entry/browser.js",
        "entry/browser.d.ts",
        "pkg/web/vortex_rdf.js",
        "pkg/web/vortex_rdf.d.ts",
        "pkg/web/vortex_rdf_bg.wasm",
        "pkg/web/vortex_rdf_bg.wasm.d.ts",
        "pkg/web/snippets/**"
    ],
    "scripts": {
        "build:wasm": "wasm-pack build --target web --out-dir pkg/web --no-pack",
        "build:wasm:fast": "wasm-pack build --target web --out-dir pkg/web --no-pack --no-opt",
        "build:clean-manifest": "node -e \"require('fs').rmSync('pkg/web/package.json',{force:true})\"",
        "build": "npm run build:wasm && npm run build:clean-manifest",
        "build:fast": "npm run build:wasm:fast && npm run build:clean-manifest",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.bench.json",
        "bench": "tsx --expose-gc --max-old-space-size=8192 bench/compare.bench.ts",
        "bench:build": "npm run build && npm run bench",
        "bench:codspeed": "tsx --expose-gc bench/codspeed.bench.ts",
        "bench:dict-memory": "tsx --expose-gc bench/dict-memory.bench.ts"
    },
    "keywords": [
        "rdf",
        "vortex",
        "columnar",
        "semantic-web",
        "wasm",
        "zero-copy"
    ],
    "author": "Julián Rojas",
    "license": "MIT",
    "devDependencies": {
        "@codspeed/tinybench-plugin": "^5.7.1",
        "@types/node": "^26.1.1",
        "oxigraph": "^0.5.9",
        "rdf-data-factory": "^2.0.2",
        "rdf-stores": "^2.2.0",
        "tinybench": "^6.1.2",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10",
        "wasm-pack": "^0.15.0"
    },
    "dependencies": {
        "@rdfjs/types": "^2.0.1"
    }
}
